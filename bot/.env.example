# Moonbag bot — Robinhood Chain. Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # https://t.me/BotFather -> /newbot
DATABASE_URL=                  # Neon -> project moonbag -> pooled connection string (dev branch locally, main on Railway)
ALCHEMY_API_KEY=               # https://dashboard.alchemy.com -> app with Robinhood Chain mainnet + testnet
UNISWAP_API_KEY=               # https://developers.uniswap.org/dashboard (mainnet swaps only)
MASTER_ENCRYPTION_KEY=         # 32+ random chars: openssl rand -hex 32
CHAIN=testnet                  # testnet | mainnet (selects RPC/WSS/explorer/chain id)
DRY_RUN=true                   # true = never send a swap, message "would buy" instead
TREASURY_ADDRESS=              # public address that receives 1% of the tokens on every buy (required on mainnet). Address only, never a key.
ADMIN_CHAT_ID=                 # optional: chat that receives failure alerts. Your user id, or a group id (add the bot first).
                               #   Basic groups have short negative ids (-5342855733); only supergroups start with -100. Both work.
                               #   Anyone in this chat can run /retry all. Unset = failures only reach the log.
PORT=3000                      # keep-alive + /health
# RPC_URL=                     # optional: override the Alchemy RPC. Only for pointing a test run at a local anvil fork.
# WSS_URL=                     # optional: same, for the WebSocket.
