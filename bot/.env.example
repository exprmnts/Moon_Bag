# Moonbag bot — Robinhood Chain. Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # https://t.me/BotFather -> /newbot
DATABASE_URL=                  # Neon -> project moonbag -> branch dev -> pooled connection string
ALCHEMY_API_KEY=               # https://dashboard.alchemy.com -> app with Robinhood Chain mainnet + testnet
UNISWAP_API_KEY=               # https://developers.uniswap.org/dashboard (needed from Phase 4)
MASTER_ENCRYPTION_KEY=         # leave blank; Claude generates it with: openssl rand -hex 32
CHAIN=testnet                  # testnet | mainnet
DRY_RUN=true                   # true = never send a swap
PORT=3000
